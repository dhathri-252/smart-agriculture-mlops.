# Optional environment configuration for the Smart Agriculture platform.
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit secrets.

# --- CORS (comma separated origins) ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080,http://smart-agriculture:5173

# --- Authentication ---
# Secret used to sign session tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left empty, an ephemeral secret is used (sessions reset on restart).
AUTH_SECRET_KEY=

# Token required in the X-Admin-Token header for GET /api/admin/stats.
# If empty, the admin endpoint reports "not configured" (HTTP 503).
ADMIN_TOKEN=

# --- Weather provider (OpenWeatherMap) ---
# If WEATHER_API_KEY is empty, /api/weather returns a clean
# "not configured" state — no weather data is ever fabricated.
WEATHER_PROVIDER=
WEATHER_API_KEY=

# --- AI assistant provider ---
# AI_PROVIDER: knowledge_base (default, built-in bilingual fallback) or openai
# OPENAI_*: only needed for AI_PROVIDER=openai. Keys stay server-side.
# OPENAI_BASE_URL may point to any OpenAI-compatible chat-completions endpoint.
# OPENAI_TIMEOUT_SECONDS: provider request timeout (default 20, clamped 5-60).
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=

# --- Persistence ---
# SQLite location (defaults to data/app.db when empty)
APP_DB_PATH=
